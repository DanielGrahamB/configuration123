msgstr ""
"Les informations du client restent privées sauf si vous les sélectionnez "
"dans la section Affichage public ci-dessous."

#: includes/class-settings.php:228
msgid "Use international format when possible."
msgstr "Utilisez le format international lorsque cela est possible."

