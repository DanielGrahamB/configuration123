#. Description of the plugin
#: configuration123.php
msgid ""
"Centralises site identity, owner details, designer attribution, services, "
"and social profiles for reusable WordPress builds."
msgstr ""
"Centralise l’identité du site, les coordonnées du propriétaire, "
"l’attribution du concepteur, les services et les profils sociaux pour des "
"créations WordPress réutilisables."

#. Author of the plugin
#: configuration123.php
msgid "Boaz Daniel Graham"
msgstr "Boaz Daniel Graham"

